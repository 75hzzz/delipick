# Local development only. start.ps1 replaces password placeholders on first run.
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_NAME=delipick
API_BIND_ADDRESS=127.0.0.1
API_PORT=18086
MYSQL_PORT=13307
QDRANT_PORT=16339
QDRANT_COLLECTION=delipick_menu_vectors
# existing: trusted single-database dump at delipick_server/database/database.sql
# demo: fictional data; prefer start.ps1 -Demo to use separate volumes and ports.
DATASET_MODE=existing
# replay: four fixed examples, no billable external calls.
# live: arbitrary natural language; requires your own API key.
QUERY_MODE=replay
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ENABLE_TASTE_LLM=false
CORS_ALLOW_ORIGINS=*
RETRIEVAL_K=100
RECALL_EXACT_THRESHOLD=200
RECALL_CHANNEL_K=40
RECALL_MIXED_K=120
RECALL_REFINE_RESTAURANTS=10

# Optional route-time refresh: startup once, then every 60 minutes.
# Uses the fixed reference coordinates in delipick_server/update_delivery.py.
ENABLE_DELIVERY_WORKER=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
